# =============================================================================
# AI Candidate Evaluation System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# ── AI / LLM Provider (Google Gemini) ─────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ── Speech-to-Text (Gemini API or Local) ────────────────────────────────────
WHISPER_MODE=

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── File Upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=./uploads

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
